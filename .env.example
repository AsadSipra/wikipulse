# Backend
WIKIPULSE_SOURCE=live          # live | replay
REPLAY_FILE=data/sample_events.jsonl
REPLAY_SPEED=1.0
WINDOW_SECONDS=300
INCLUDE_BOTS=false
WIKIPEDIA_ONLY=true            # drop Wikidata, Commons and other sister projects
CORS_ORIGINS=http://localhost:5173
# AI: any OpenAI-compatible endpoint. Defaults use a local Ollama.
AI_ENABLED=true
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2
LLM_API_KEY=
# Docker only: with Ollama, the container must use host.docker.internal instead of localhost
# DOCKER_LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_TIMEOUT=30
LLM_MAX_TOKENS=300
VANDALISM_CALLS_PER_MINUTE=16
PULSE_CALLS_PER_MINUTE=4
PULSE_INTERVAL_SECONDS=60
FETCH_DIFFS=true               # false = rules-only vandalism flags (no AI review)
